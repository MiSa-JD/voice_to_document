# Host paths mounted by Docker Compose
DATA_ROOT=./runtime

# Optional host-path overrides. Leave empty to use DATA_ROOT/inbox and DATA_ROOT/transcripts.
RECORDING_INPUT_HOST_DIR=
TRANSCRIPT_HOST_DIR=

APP_RUN_UID=1000
APP_RUN_GID=1000

# Container paths shared by api and worker
RECORDING_INPUT_DIR=/data/inbox
TRANSCRIPT_ROOT=/data/transcripts
SPEAKER_ROOT=/data/speakers
DOCUMENT_ROOT=/data/documents
APP_DATA_DIR=/data/app

SCAN_INTERVAL_SECONDS=10
FILE_STABLE_SECONDS=30
CATEGORIES=강의,일상 대화,회의,게임 목록,기타
AUTO_SUMMARY_CATEGORIES=강의,회의

# Fake mode remains the default. R4 can enable real speech without enabling an LLM.
SPEECH_MODE=fake
DOCUMENT_MODE=fake
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=
WHISPER_BATCH_SIZE=4
HF_TOKEN=

# Host directory for downloaded WhisperX, pyannote, and Torch model caches.
MODEL_CACHE_ROOT=./runtime/model-cache
NLTK_CACHE_ROOT=./runtime/nltk-cache

# Git-ignored host directory containing the three private R4 evaluation samples.
MODEL_EVAL_ROOT=./runtime/model-eval
MODEL_EVAL_BATCH_SIZES=4,8,16

# Decide provider/model before R7. Never commit real credentials.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

APP_BIND_HOST=0.0.0.0
APP_PORT=38000
LOG_LEVEL=INFO
