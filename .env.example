# Host paths mounted by Docker Compose
DATA_ROOT=./runtime
APP_RUN_UID=1000
APP_RUN_GID=1000

# Container paths shared by api and worker
RECORDING_INPUT_DIR=/data/inbox
TRANSCRIPT_ROOT=/data/transcripts
SPEAKER_ROOT=/data/speakers
SUMMARY_ROOT=/data/documents
APP_DATA_DIR=/data/app

SCAN_INTERVAL_SECONDS=10
FILE_STABLE_SECONDS=30
CATEGORIES=강의,일상 대화,회의,게임 목록,기타
AUTO_SUMMARY_CATEGORIES=강의,회의

# Fake mode remains the default. R4 can enable real speech without enabling an LLM.
SPEECH_MODE=fake
DOCUMENT_MODE=fake
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=
HF_TOKEN=

# Host directory for downloaded WhisperX, pyannote, and Torch model caches.
MODEL_CACHE_ROOT=./runtime/model-cache

# Decide provider/model before R7. Never commit real credentials.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

APP_BIND_HOST=0.0.0.0
APP_PORT=38000
LOG_LEVEL=INFO
